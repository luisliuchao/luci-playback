{
  "name": "Luci Playback",
  "short_name": "Luci Playback",
  "description": "Local browser player for Luci screen-memory frames and audio. Files stay on this computer and are never uploaded.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
